{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=/app/Data/FountainBistro.db"
  },
  
  "SbpSettings": {
    "ApiUrl": "${SBP_API_URL}",
    "ApiKey": "${SBP_API_KEY}",
    "MerchantId": "${SBP_MERCHANT_ID}",
    "CallbackUrl": "${SBP_CALLBACK_URL}"
  },
  
  "PushSettings": {
    "VapidPublicKey": "${VAPID_PUBLIC_KEY}",
    "VapidPrivateKey": "${VAPID_PRIVATE_KEY}",
    "VapidSubject": "mailto:admin@fountainbistro.com"
  },
  
  "CacheSettings": {
    "MenuCacheDurationMinutes": 10,
    "CartCacheDurationMinutes": 30
  },
  
  "AppSettings": {
    "CompanyName": "Fountain Bistro",
    "CompanyPhone": "+7 (999) 123-45-67",
    "SessionTimeoutMinutes": 30,
    "MaxOrderItems": 50,
    "MaxCartItems": 100
  }
}
