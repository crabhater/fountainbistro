{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=FountainBistro.db"
  },
  
  "SbpSettings": {
    "ApiUrl": "https://sbp-api.example.com",
    "ApiKey": "your-api-key",
    "MerchantId": "your-merchant-id",
    "CallbackUrl": "https://your-domain.com/order/webhook"
  },
  
  "PushSettings": {
    "VapidPublicKey": "your-public-key",
    "VapidPrivateKey": "your-private-key",
    "VapidSubject": "mailto:admin@fountainbistro.com"
  },
  
  "CacheSettings": {
    "MenuCacheDurationMinutes": 10,
    "CartCacheDurationMinutes": 30
  },
  
  "AppSettings": {
    "CompanyName": "Fountain Bistro",
    "CompanyPhone": "+7 (999) 123-45-67",
    "SessionTimeoutMinutes": 30,
    "MaxOrderItems": 50,
    "MaxCartItems": 100
  }
}
